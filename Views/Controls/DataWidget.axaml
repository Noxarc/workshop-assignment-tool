<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WorkshopAssignment.Views.Controls.DataWidget">

    <UserControl.Styles>
        <Style Selector="Border.summary-card">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#f8f9fa" Offset="0"/>
                        <GradientStop Color="#ffffff" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.summary-card:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource Teal500Brush}"/>
            <Setter Property="BoxShadow" Value="0 0 12 0 #3055acbf"/>
        </Style>
        <Style Selector="TextBlock.big-number">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource HeaderBlueBrush}"/>
        </Style>
        <Style Selector="TextBlock.card-label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
        </Style>
        <Style Selector="TextBlock.detail-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.detail-value">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
        </Style>
        <Style Selector="PathIcon.card-arrow">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource Teal500Brush}"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.summary-card:pointerover PathIcon.card-arrow">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#E6FFFFFF" BorderBrush="#b0b0b0" BorderThickness="1" CornerRadius="6" Padding="16,12"
            BoxShadow="0 4 12 0 #30000000">
        <StackPanel Spacing="12">
            <TextBlock Text="{Binding ViewModel[data.pageTitle]}" FontSize="20" FontWeight="Bold" Foreground="#1a1a2e"/>
            <Border Classes="summary-card" PointerPressed="WorkshopsCard_PointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="Slot2CapacityLabel" Text="{Binding ViewModel[data.slotCapacityPrefix]}" Classes="detail-label"/>
                                <TextBlock x:Name="Slot2CapacityText" Text="0" Classes="detail-value"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="Slot3CapacityLabel" Text="{Binding ViewModel[data.slotCapacityPrefix]}" Classes="detail-label"/>
                                <TextBlock x:Name="Slot3CapacityText" Text="0" Classes="detail-value"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <TextBlock x:Name="WorkshopCountText" Text="0" Classes="big-number" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding ViewModel[data.workshops]}" Classes="card-label" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                    <PathIcon Grid.Column="1" Classes="card-arrow" Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Classes="summary-card" PointerPressed="PeopleCard_PointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding ViewModel[data.infoGroups]}" Classes="detail-label"/>
                                <TextBlock x:Name="InfoGroupCountText" Text="0" Classes="detail-value"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding ViewModel[data.friendGroups]}" Classes="detail-label"/>
                                <TextBlock x:Name="FriendGroupCountText" Text="0" Classes="detail-value"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <TextBlock x:Name="PersonCountText" Text="0" Classes="big-number" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding ViewModel[data.people]}" Classes="card-label" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                    <PathIcon Grid.Column="1" Classes="card-arrow" Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
