<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: macOS Apple Silicon (M1/M2/M3/M4+)
  Usage: dotnet publish -p:PublishProfile=osx-arm64
  
  Self-contained deployment bundles .NET 10 runtime — no user installation required.
  Trimming DISABLED: OrTools (P/Invoke native solver), ClosedXML (reflection-based Excel),
  QuestPDF (SkiaSharp native), and Avalonia 11.2.2 are not trim-safe.
  SingleFile DISABLED: OrTools native .dylib extraction adds startup latency; distribution
  model is zip-and-extract so SingleFile provides no user benefit.
  ReadyToRun ENABLED: Pre-compiles IL to native ARM64 code for faster cold startup.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <PublishDir>bin/publish/osx-arm64</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <!-- Self-contained: bundle .NET runtime so users need zero prerequisites -->
    <SelfContained>true</SelfContained>

    <!-- ReadyToRun: AOT-compile to ARM64 native for faster startup on Apple Silicon -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Trimming disabled: OrTools uses P/Invoke for native solver binaries,
         ClosedXML uses System.Reflection for Excel cell mapping,
         QuestPDF depends on SkiaSharp native rendering,
         Avalonia 11.2.2 trimming support is experimental.
         Enabling trimming would cause runtime MissingMethodExceptions. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- SingleFile disabled: OrTools ships ~50MB native .dylib that must be extracted
         to temp directory at startup when bundled as SingleFile, adding 2-5s cold start
         and requiring write access to temp. Zip distribution makes this unnecessary. -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
</Project>
