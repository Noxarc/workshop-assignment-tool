<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: Windows x64
  Usage: dotnet publish -p:PublishProfile=win-x64
  
  Self-contained deployment bundles .NET 10 runtime — no user installation required.
  Trimming DISABLED: OrTools (P/Invoke native solver), ClosedXML (reflection-based Excel),
  QuestPDF (SkiaSharp native), and Avalonia 11.2.2 are not trim-safe.
  SingleFile ENABLED with IncludeNativeLibrariesForSelfExtract: produces a truly single
  .exe with all native DLLs embedded — no temp extraction, no SFX wrapper needed.
  IncludeAllContentForSelfExtract ENABLED: bundles Content items (localization JSON files)
  inside the exe and extracts them to AppContext.BaseDirectory at runtime.
  ReadyToRun ENABLED: Pre-compiles IL to native x64 code for faster cold startup.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\publish\win-x64</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <!-- Self-contained: bundle .NET runtime so users need zero prerequisites -->
    <SelfContained>true</SelfContained>

    <!-- ReadyToRun: AOT-compile to x64 native for faster startup on Windows -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Trimming disabled: OrTools uses P/Invoke for native solver binaries,
         ClosedXML uses System.Reflection for Excel cell mapping,
         QuestPDF depends on SkiaSharp native rendering,
         Avalonia 11.2.2 trimming support is experimental.
         Enabling trimming would cause runtime MissingMethodExceptions. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- SingleFile enabled: produces one distributable .exe for simpler deployment.
         IncludeNativeLibrariesForSelfExtract embeds all native .dlls (OrTools, SkiaSharp)
         directly inside the single exe — no temp extraction needed, no SFX wrapper required.
         IncludeAllContentForSelfExtract bundles Content items (localization JSON files)
         inside the exe and extracts them to AppContext.BaseDirectory at runtime —
         exactly where LocalizationService.LoadJsonFromResources looks for them. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <!-- Windows-specific: use the app.manifest for DPI awareness and OS compatibility -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- GUI subsystem: explicitly sets PE subsystem to 2 (GUI) in the SingleFile apphost.
         Without this, cross-compiled SingleFile publish produces PE subsystem 3 (Console),
         causing a visible console window on launch despite OutputType=WinExe in the csproj. -->
    <UseWindowsGraphicalUserInterface>true</UseWindowsGraphicalUserInterface>
  </PropertyGroup>
</Project>
